<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mac Netinstall talks to MikroTik devices on the local network (BOOTP, TFTP and Netinstall) to install RouterOS on them.</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hu</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Files this app creates (the downloaded update, exported logs,
	     cached RouterOS files) carry com.apple.quarantine, so Gatekeeper
	     checks anything opened from them. The update DMG is also marked
	     explicitly (ni-update). -->
	<key>LSFileQuarantineEnabled</key>
	<true/>
</dict>
</plist>
