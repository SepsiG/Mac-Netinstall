{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Netinstall",
  "version": "0.1.4",
  "identifier": "io.github.sepsig.mac-netinstall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mac Netinstall",
        "width": 1040,
        "height": 680,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/16x16.png",
      "icons/16x16@2x.png",
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512@2x.png"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "MikroTik Netinstall for macOS",
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./locales/en.lproj/InfoPlist.strings",
        "Resources/hu.lproj/InfoPlist.strings": "./locales/hu.lproj/InfoPlist.strings"
      },
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 180 },
        "applicationFolderPosition": { "x": 480, "y": 180 }
      }
    }
  }
}
